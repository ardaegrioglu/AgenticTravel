GOOGLE_API_KEY=
GOOGLE_GENAI_MODEL=gemini-3.5-flash-lite
DUFFEL_API_KEY=

# Foursquare Service API Key (Bearer token format).
# Get one at https://location.foursquare.com → create project → copy the Service API Key.
FOURSQUARE_API_KEY=

# Set to "true" to use hardcoded fixture data instead of calling the real
# Duffel / Foursquare APIs. Useful for developing the agent/UI without keys.
MOCK_PROVIDERS=true

# Optional: SerpApi key (https://serpapi.com, free tier = 250 searches/month).
# Enables priced hotel results from Google Hotels when Duffel Stays is unavailable.
SERPAPI_API_KEY=

# Prefetch flights/hotels/places in parallel right after preferences are
# extracted (default "true"). Set "false" for the tools-only baseline.
SPECULATIVE_SEARCH=true

# Optional: Redis for the shared search cache (falls back to in-memory if unset).
# docker compose sets this automatically.
REDIS_URL=
